<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-00002016" version="1.0.6190">
  <head std:sid="head-00002017">
    <screen std:sid="screen-00002018" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-00002019" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-0000201a" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-0000201b"/>
    <cl:appspec dev-description="반려 제출 카드" title="반려 제출 카드">
      <cl:property name="no" type="string" bindable="true" std:desc="[String] 번호"/>
      <cl:property name="templateName" type="string" bindable="true" std:desc="[String] 템플릿명"/>
      <cl:property name="formNo" type="string" bindable="true" std:desc="[String] PSE Form No."/>
      <cl:property name="rejectedBy" type="string" bindable="true" std:desc="[String] 반려자"/>
      <cl:property name="rejectionDate" type="string" bindable="true" std:desc="[String] 반려일시 (YYYYMMDDhhmmss)"/>
      <cl:property name="isRead" type="string" bindable="true" std:desc="[String] 읽음 여부 (Y/N) — N 이면 강조 표시"/>
    </cl:appspec>
  </head>
  <body std:sid="body-0000201c" style="top:0px; left:0px; width:416px; height:290px;">
    <cl:listener std:sid="listener-0000201d" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-0000201e" name="property-change" handler="onBodyPropertyChange"/>
    <cl:group std:sid="group-0000201f" id="grpCard" class="toggle-card">
      <cl:formdata std:sid="f-data-00002020" row="0" col="0"/>
      <cl:group std:sid="group-00002021">
        <cl:verticaldata std:sid="v-data-00002022" width="382px" height="52px" autosize="height"/>
        <cl:group std:sid="group-00002023">
          <cl:verticaldata std:sid="v-data-00002024" width="390px" height="28px" autosize="height"/>
          <cl:group std:sid="group-00002025">
            <cl:formdata std:sid="f-data-00002026" row="0" col="0"/>
            <cl:output std:sid="output-00002027" class="font-caption-strong" value="1" displayexp="&quot;No. &quot; + text">
              <cl:apppropbind property="value" app-property="no"/>
              <cl:flowlayoutdata std:sid="f-data-00002028" width="115px" height="28px" autosize="width"/>
            </cl:output>
            <cl:flowlayout std:sid="f-layout-00002029"/>
          </cl:group>
          <cl:group std:sid="group-0000202a">
            <cl:formdata std:sid="f-data-0000202b" row="0" col="1"/>
            <cl:checkbox std:sid="c-box-e8649a67" id="cbxMail" class="chk-mail" fieldLabel="Unread" truevalue="Y" falsevalue="N" text="Unread">
              <std:metadata>
                <std:property key="template-uuid" value="70ecc1f1-5379-44fd-bd4c-c8721756d3db"/>
                <std:property key="template-rev" value="1"/>
              </std:metadata>
              <cl:listener std:sid="listener-c6fafa9e" name="value-change" handler="onCbxMailValueChange"/>
              <cl:flowlayoutdata std:sid="f-data-0be234e6" width="28px" height="28px" autosize="none"/>
            </cl:checkbox>
            <cl:button std:sid="button-0000202e" class="icon btn-file" fieldLabel="Remarks" icon="0">
              <cl:flowlayoutdata std:sid="f-data-0000202f" width="28px" height="28px"/>
            </cl:button>
            <cl:flowlayout std:sid="f-layout-00002030" halign="right"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-00002031" scrollable="false" hspace="1fr" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="150" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
            <cl:columns length="150" unit="PIXEL" autoSizing="true" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:button std:sid="button-00002032" class="btn-link ellipsis-2 p-0" value="Template Name">
          <cl:apppropbind property="value" app-property="templateName"/>
          <cl:verticaldata std:sid="v-data-00002033" width="390px" height="20px" autosize="height"/>
        </cl:button>
        <cl:verticallayout std:sid="v-layout-00002034" spacing="4"/>
      </cl:group>
      <cl:group std:sid="group-00002001">
        <cl:verticaldata std:sid="v-data-00002002" width="390px" height="43px" autosize="height"/>
        <cl:output std:sid="output-00002003" class="font-micro" value="PSE Form No.">
          <cl:verticaldata std:sid="v-data-00002004" width="100px" height="20px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-00002005" class="font-body-s" value="17-1">
          <cl:apppropbind property="value" app-property="formNo"/>
          <cl:verticaldata std:sid="v-data-00002006" width="353px" height="20px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-00002007" spacing="4"/>
      </cl:group>
      <cl:group std:sid="group-00002008">
        <cl:verticaldata std:sid="v-data-00002009" width="390px" height="43px" autosize="height"/>
        <cl:output std:sid="output-0000200a" class="font-micro" value="Rejected By">
          <cl:verticaldata std:sid="v-data-0000200b" width="100px" height="20px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-0000200c" class="font-body-s" value="Maria Santos (PSE)">
          <cl:apppropbind property="value" app-property="rejectedBy"/>
          <cl:verticaldata std:sid="v-data-0000200d" width="353px" height="20px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-0000200e" spacing="4"/>
      </cl:group>
      <cl:group std:sid="group-0000200f">
        <cl:verticaldata std:sid="v-data-00002010" width="390px" height="43px" autosize="height"/>
        <cl:output std:sid="output-00002011" class="font-micro" value="Rejection Date and Time">
          <cl:verticaldata std:sid="v-data-00002012" width="100px" height="20px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-00002013" class="font-body-s" value="20260825145618" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
          <cl:apppropbind property="value" app-property="rejectionDate"/>
          <cl:verticaldata std:sid="v-data-00002014" width="353px" height="20px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-00002015" spacing="4"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-00002035" spacing="10"/>
    </cl:group>
    <cl:formlayout std:sid="f-layout-00002036" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="1" unit="FRACTION"/>
      <cl:columns length="1" unit="FRACTION"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>