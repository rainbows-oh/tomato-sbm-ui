    <cl:model std:sid="model-c289c007"/>
    <cl:appspec title="페이지 인덱서">
      <cl:property name="ctrl" type="control" std:desc="[Grid] 대상 그리드 객체"/>
      <cl:property name="pageInfo" type="control" std:desc="[DataMap] 페이지 정보를 담을 데이터맵 객체&#xD;&#xA;&#xD;&#xA;데이터맵은 다음 컬럼을 포함해야 합니다.&#xD;&#xA;- totalCount : 전체 건 수&#xD;&#xA;- size  : 한 페이지당 보여줄 건 수&#xD;&#xA;- page : 페이지 번호&#xD;&#xA;- pageIndexerCount : 보여지는 페이지 수"/>
      <cl:event name="pagechange" type="cpr.events.CSelectionEvent"/>
      <cl:event name="before-pagechange" type="cpr.events.CSelectionEvent"/>
    </cl:appspec>
  </head>
  <body std:sid="body-ab560aa1" style="top:0px; left:0px; width:1000px; height:36px;" class="udc-pagination">
    <cl:listener std:sid="listener-497d5d94" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-287c526d" name="screen-change" handler="onBodyScreenChange"/>
    <cl:attribute name="hide-on-mobile" value=""/>
    <cl:group std:sid="group-edd1a07c" id="grpPaging">
