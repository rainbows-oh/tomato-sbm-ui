<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-cm000001" version="1.0.6190">
  <head std:sid="head-cm000002">
    <screen std:sid="screen-cm000003" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-cm000004" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-cm000005" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-cm000006">
      <cl:dataset std:sid="d-set-cm000007" id="dsList">
        <cl:datacolumnlist>
          <cl:datacolumn comment="Version" std:sid="d-column-cm000008" name="version"/>
          <cl:datacolumn comment="Submission Date and Time" std:sid="d-column-cm000009" name="submissionDate"/>
          <cl:datacolumn comment="Submitted By" std:sid="d-column-cm000010" name="submittedBy"/>
          <cl:datacolumn comment="Endorsed To" std:sid="d-column-cm000011" name="endorsedTo"/>
          <cl:datacolumn comment="Approver Result" std:sid="d-column-cm000012" name="approverResult"/>
          <cl:datacolumn comment="PSE Admin Result" std:sid="d-column-cm000013" name="pseAdminResult"/>
          <cl:datacolumn comment="Final Status" std:sid="d-column-cm000014" name="finalStatus"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[1]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260820091244]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverResult"><![CDATA[pending]]></cl:datavalue>
            <cl:datavalue columnname="pseAdminResult"><![CDATA[notStarted]]></cl:datavalue>
            <cl:datavalue columnname="finalStatus"><![CDATA[pendingApproval]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[2]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260820091244]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverResult"><![CDATA[approved]]></cl:datavalue>
            <cl:datavalue columnname="pseAdminResult"><![CDATA[rejected]]></cl:datavalue>
            <cl:datavalue columnname="finalStatus"><![CDATA[rejected]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[3]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260820091244]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverResult"><![CDATA[rejected]]></cl:datavalue>
            <cl:datavalue columnname="pseAdminResult"><![CDATA[notStarted]]></cl:datavalue>
            <cl:datavalue columnname="finalStatus"><![CDATA[rejected]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[4]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260820091244]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverResult"><![CDATA[approved]]></cl:datavalue>
            <cl:datavalue columnname="pseAdminResult"><![CDATA[approved]]></cl:datavalue>
            <cl:datavalue columnname="finalStatus"><![CDATA[approved]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec/>
  </head>
  <body std:sid="body-cm000015">
    <cl:group std:sid="group-cm000016" id="grpHeader" class="page-title-wrap">
      <cl:attribute name="mobile-column-count" value="1"/>
      <cl:attribute name="needs-auto-height" value="true"/>
      <cl:verticaldata std:sid="v-data-cm000017" width="1024px" height="48px" autosize="height" sticky="true" stickytopoffset="0"/>
      <cl:udc std:sid="ud-control-a245490b" id="udccomappheader1" type="udc.pse.com.udcComAppHeader">
        <cl:attribute name="needs-auto-height" value="true"/>
        <cl:formdata std:sid="f-data-b53b218e" row="0" col="0"/>
      </cl:udc>
      <cl:group std:sid="group-cm000020" class="btn-wrap">
        <cl:formdata std:sid="f-data-cm000021" valign="FILL" height="36" row="0" col="1"/>
        <cl:button std:sid="button-cm000022" class="btn-secondary" value="Logo">
          <cl:listener std:sid="listener-9f0eb538" name="click" handler="onButtonClick2"/>
          <cl:flowlayoutdata std:sid="f-data-cm000023" width="86px" height="36px" autosize="width"/>
        </cl:button>
        <cl:button std:sid="button-cm000024" class="btn-primary btn-add" value="Update Company Info" icon="0">
          <cl:flowlayoutdata std:sid="f-data-cm000025" width="180px" height="36px" autosize="width"/>
        </cl:button>
        <cl:flowlayout std:sid="f-layout-cm000026" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
      </cl:group>
      <cl:formlayout std:sid="f-layout-cm000027" scrollable="false" hspace="8px" vspace="12px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="36" unit="PIXEL"/>
        <cl:columns length="1" unit="FRACTION"/>
        <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      </cl:formlayout>
    </cl:group>
    <cl:group std:sid="group-cm000028" id="grpBody" class="inner">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:verticaldata std:sid="v-data-cm000029" width="1024px" height="685px" autosize="height"/>
      <cl:group std:sid="group-cm000030" id="grpContent" class="section">
        <cl:attribute name="mobile-spacing" value="16"/>
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:verticaldata std:sid="v-data-cm000031" width="960px" height="649px" autosize="height"/>
        <cl:group std:sid="group-cm000032" class="search-list-top">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata std:sid="v-data-cm000033" width="400px" height="36px" autosize="height"/>
          <cl:group std:sid="group-3126b9c3">
            <cl:formdata std:sid="f-data-cm000035" row="0" col="0" rowspan="1" colspan="1"/>
            <cl:output std:sid="output-cm000034" class="sch-info" value="4" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; company information update versions&quot;">
              <cl:flowlayoutdata std:sid="f-data-44732494" width="96px" height="36px" autosize="width"/>
            </cl:output>
            <cl:flowlayout std:sid="f-layout-71cf92e3" hspacing="12"/>
          </cl:group>
          <cl:group std:sid="group-cm000036">
            <cl:formdata std:sid="f-data-cm000037" row="0" col="1"/>
            <cl:udc std:sid="ud-control-cm000038" id="udccomviewbutton1" type="udc.pse.com.udcComViewButton">
                <cl:flowlayoutdata std:sid="f-data-cm000039" width="76px" height="36px" autosize="both"/>
                <cl:property name="targetTable" value="grpGridSection" type="control"/>
                <cl:property name="targetCard" value="grpCardSection" type="control"/>
              </cl:udc>
            <cl:combobox std:sid="c-box-87b3d90e" fieldLabel="Rows per page" value="15">
              <cl:flowlayoutdata std:sid="f-data-5bab1eec" width="110px" height="36px" autosize="none"/>
              <cl:item std:sid="item-215b8892" label="15/page" value="15"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-b9d8249e" scrollable="false" hspacing="12" vspacing="12" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-039a7b88" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="500" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="400" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-cm000042" id="grpGridSection" datasetid="dsList" autofit="1, 2, 3, 4, 5, 6" resizablecolumns="all" columnMovable="true">
          <cl:verticaldata std:sid="v-data-cm000043" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-cm000044" width="72px"/>
          <cl:gridcolumn std:sid="g-column-cm000045" width="190px"/>
          <cl:gridcolumn std:sid="g-column-cm000046" width="160px"/>
          <cl:gridcolumn std:sid="g-column-cm000047" width="160px"/>
          <cl:gridcolumn std:sid="g-column-cm000048" width="140px"/>
          <cl:gridcolumn std:sid="g-column-cm000049" width="140px"/>
          <cl:gridcolumn std:sid="g-column-cm000050" width="140px"/>
          <cl:gridheader std:sid="gh-band-cm000051">
            <cl:gridrow std:sid="g-row-cm000052" height="32px"/>
            <cl:gridcell std:sid="gh-cell-cm000053" rowindex="0" colindex="0" targetcolumnname="version" sortable="true" filterable="false" text="Version"/>
            <cl:gridcell std:sid="gh-cell-cm000054" rowindex="0" colindex="1" targetcolumnname="submissionDate" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-cm000055" rowindex="0" colindex="2" targetcolumnname="submittedBy" sortable="true" filterable="false" text="Submitted By"/>
            <cl:gridcell std:sid="gh-cell-cm000056" rowindex="0" colindex="3" targetcolumnname="endorsedTo" sortable="true" filterable="false" text="Endorsed To"/>
            <cl:gridcell std:sid="gh-cell-cm000057" rowindex="0" colindex="4" targetcolumnname="approverResult" sortable="true" filterable="false" text="Approver Result"/>
            <cl:gridcell std:sid="gh-cell-cm000058" rowindex="0" colindex="5" targetcolumnname="pseAdminResult" sortable="true" filterable="false" text="PSE Admin Result"/>
            <cl:gridcell std:sid="gh-cell-cm000059" rowindex="0" colindex="6" targetcolumnname="finalStatus" sortable="true" filterable="false" text="Final Status"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-cm000060">
            <cl:gridrow std:sid="g-row-cm000061" height="50px"/>
            <cl:gridcell std:sid="gd-cell-cm000062" rowindex="0" colindex="0" columnname="version">
              <cl:button std:sid="button-cm000063" class="btn-link" value="Button">
                <cl:listener std:sid="listener-c2f0b03b" name="click" handler="onButtonClick"/>
                <cl:celldata std:sid="c-data-cm000064"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000065" rowindex="0" colindex="1" columnname="submissionDate">
              <cl:output std:sid="output-cm000066" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-cm000067"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000068" rowindex="0" colindex="2" columnname="submittedBy">
              <cl:output std:sid="output-cm000069">
                <cl:celldata std:sid="c-data-cm000070"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000071" rowindex="0" colindex="3" columnname="endorsedTo">
              <cl:output std:sid="output-cm000072">
                <cl:celldata std:sid="c-data-cm000073"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000074" rowindex="0" colindex="4" columnname="approverResult">
              <cl:output std:sid="output-cm000075" displayexp="sstr(@getBadgeText(value), @getBadgeClass(value))">
                <cl:celldata std:sid="c-data-cm000076"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000077" rowindex="0" colindex="5" columnname="pseAdminResult">
              <cl:output std:sid="output-cm000078" displayexp="sstr(@getBadgeText(value), @getBadgeClass(value))">
                <cl:celldata std:sid="c-data-cm000079"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cm000080" rowindex="0" colindex="6" columnname="finalStatus">
              <cl:output std:sid="output-cm000081" displayexp="sstr(@getBadgeText(value), @getBadgeClass(value))">
                <cl:celldata std:sid="c-data-cm000082"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:group std:sid="group-1b791d41" id="grpCardSection" class="card-section" visible="false">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="mobile-h-spacing" value="12"/>
          <cl:attribute name="mobile-v-spacing" value="12"/>
          <cl:verticaldata std:sid="v-data-c174a6fd" width="976px" height="313px" autosize="height"/>
          <cl:udc std:sid="ud-control-8fe2ffed" id="udccomcompanymanagementcard1" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-5d7803f1" row="0" col="0"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-d32188be" id="udccomcompanymanagementcard2" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-12fbedbd" row="0" col="1"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-116b3599" id="udccomcompanymanagementcard3" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-898a7ab7" row="0" col="2"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-9ec8d59e" scrollable="false" hspace="16px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:udc std:sid="ud-control-cm000083" id="udccompagination1" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-cm000084" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-cm000085" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-cm000086" scrollable="false" spacing="20" leftmargin="32" rightmargin="32" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-cm000087" scrollable="true" spacing="0"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>