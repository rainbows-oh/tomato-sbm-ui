          <cl:gridcolumn std:sid="g-column-cf9a3c2f" width="120px"/>
          <cl:gridcolumn std:sid="g-column-8ca58190" width="200px"/>
          <cl:gridheader std:sid="gh-band-b1bd97c9">
            <cl:gridrow std:sid="g-row-62591994" height="32px"/>
            <cl:gridcell std:sid="gh-cell-d0a8a1f0" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No"/>
            <cl:gridcell std:sid="gh-cell-16308771" rowindex="0" colindex="1" sortable="false" filterable="false" text=""/>
            <cl:gridcell std:sid="gh-cell-c9e165fd" rowindex="0" colindex="2" targetcolumnname="classification" sortable="true" filterable="false" text="Classification"/>
            <cl:gridcell std:sid="gh-cell-7f6bb1cb" rowindex="0" colindex="3" targetcolumnname="subject" sortable="true" filterable="false" text="Subject"/>
            <cl:gridcell std:sid="gh-cell-0fe0278c" rowindex="0" colindex="4" targetcolumnname="from" sortable="true" filterable="false" text="From"/>
            <cl:gridcell std:sid="gh-cell-b702fa3f" rowindex="0" colindex="5" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-d22bd7f1" rowindex="0" colindex="6" targetcolumnname="receivedAt" sortable="true" filterable="false" text="Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-85ad394e">
            <cl:gridrow std:sid="g-row-51c247c2" height="50px"/>
            <cl:gridcell std:sid="gd-cell-4e32f63b" rowindex="0" colindex="0" columnname="no">
              <cl:output std:sid="output-512b6486">
                <cl:celldata std:sid="c-data-6619ef4e"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-999274a9" rowindex="0" colindex="1" columnname="unread">
              <cl:checkbox std:sid="c-box-13236f09" class="chk-mail" fieldLabel="Unread" truevalue="0" falsevalue="1" text="Unread">
                <cl:celldata std:sid="c-data-aae1d0b9" halign="CENTER" valign="CENTER" width="28" height="28"/>
              </cl:checkbox>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-7205843d" rowindex="0" colindex="2" columnname="classification">
              <cl:output std:sid="output-34ddcf93">
                <cl:celldata std:sid="c-data-bf17fd5e"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-ca4b71f4" rowindex="0" colindex="3" columnname="subject">
              <cl:button std:sid="button-adfb18bb" class="btn-link ellipsis-2" displayexp="subject + (count ? sstr(count, &quot;badge count answered&quot;) : &quot;&quot;)">
                <cl:expbind property="value" category="PROPERTY" expression="subject"/>
                <cl:celldata std:sid="c-data-c0547ff0"/>
              </cl:button>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-fb39a488" rowindex="0" colindex="4" columnname="from">
              <cl:output std:sid="output-19ba7762">
                <cl:celldata std:sid="c-data-c3907b15"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-16cd194e" rowindex="0" colindex="5" columnname="status">
              <cl:output std:sid="output-3c3308f9" displayexp="sstr(text, &quot;badge fill blue&quot;)">
                <cl:celldata std:sid="c-data-89c8222c"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-9a8b2320" rowindex="0" colindex="6" columnname="receivedAt">
              <cl:output std:sid="output-d46e3406" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-3142f555"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
