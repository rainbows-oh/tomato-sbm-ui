          <cl:verticaldata std:sid="v-data-csm000129" width="400px" height="36px" autosize="height"/>
          <cl:group std:sid="group-1756a39c" id="grp3">
            <cl:formdata std:sid="f-data-36d7ccef" row="0" col="0" rowspan="1" colspan="1"/>
            <cl:output std:sid="output-csm000130" id="opt2" class="sch-info" value="12" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; correspondences&quot;">
              <cl:flowlayoutdata std:sid="f-data-552053ab" width="96px" height="36px" autosize="width"/>
            </cl:output>
            <cl:flowlayout std:sid="f-layout-537e7170" hspacing="12"/>
