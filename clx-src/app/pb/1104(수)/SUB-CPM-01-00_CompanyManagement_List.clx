<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-csm000001" version="1.0.6190">
  <head std:sid="head-csm000002">
    <screen std:sid="screen-csm000003" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-csm000004" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-csm000005" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-csm000006">
      <cl:dataset std:sid="d-set-csm000007" id="dsList">
        <cl:datacolumnlist>
          <cl:datacolumn comment="Version" std:sid="d-column-65c1d4b4" name="version"/>
          <cl:datacolumn comment="Submission Date and Time" std:sid="d-column-f945e4b6" name="submissionDate"/>
          <cl:datacolumn comment="Submitted By" std:sid="d-column-3083d49e" name="submittedBy"/>
          <cl:datacolumn comment="Endorsed To" std:sid="d-column-5532e8ba" name="endorsedTo"/>
          <cl:datacolumn comment="Approver Status" std:sid="d-column-e706437b" name="approverStatus"/>
          <cl:datacolumn comment="Exchange Status" std:sid="d-column-2f5ae757" name="exchangeStatus"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[Ver. 4]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260825145618]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverStatus"><![CDATA[Pending]]></cl:datavalue>
            <cl:datavalue columnname="exchangeStatus"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[Ver. 3]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260822132209]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverStatus"><![CDATA[Approved]]></cl:datavalue>
            <cl:datavalue columnname="exchangeStatus"><![CDATA[Rejected]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[Ver. 2]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260821104518]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverStatus"><![CDATA[Rejected]]></cl:datavalue>
            <cl:datavalue columnname="exchangeStatus"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="version"><![CDATA[Ver. 1]]></cl:datavalue>
            <cl:datavalue columnname="submissionDate"><![CDATA[20260820091244]]></cl:datavalue>
            <cl:datavalue columnname="submittedBy"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="endorsedTo"><![CDATA[Alex Thompson]]></cl:datavalue>
            <cl:datavalue columnname="approverStatus"><![CDATA[Approved]]></cl:datavalue>
            <cl:datavalue columnname="exchangeStatus"><![CDATA[Approved]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec/>
  </head>
  <body std:sid="body-csm000015">
    <cl:group std:sid="group-0319b359" id="grpHeader" class="page-title-wrap">
      <cl:attribute name="mobile-column-count" value="1"/>
      <cl:attribute name="needs-auto-height" value="true"/>
      <cl:verticaldata std:sid="v-data-dddbbb01" width="1024px" height="48px" autosize="height" sticky="true" stickytopoffset="0"/>
      <cl:udc std:sid="ud-control-1d70da47" id="udccomappheader1" type="udc.pse.com.udcComAppHeader">
        <cl:attribute name="needs-auto-height" value="true"/>
        <cl:formdata std:sid="f-data-dc4ac2b2" row="0" col="0"/>
        <cl:property name="title" value="Company Management" type="string"/>
      </cl:udc>
      <cl:group std:sid="group-cm000020" id="grp6">
        <cl:formdata std:sid="f-data-4f2ec45e" row="0" col="1"/>
        <cl:button std:sid="button-cm000022" id="btn2" class="btn-secondary" value="Logo">
          <cl:flowlayoutdata std:sid="f-data-cm000023" width="100px" height="36px" autosize="width"/>
        </cl:button>
        <cl:button std:sid="button-cm000024" id="btn3" class="btn-primary btn-add" value="Update Company Info" icon="0">
          <cl:flowlayoutdata std:sid="f-data-cm000025" width="150px" height="36px" autosize="width"/>
        </cl:button>
        <cl:flowlayout std:sid="f-layout-cm000026" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
      </cl:group>
      <cl:formlayout std:sid="f-layout-631b2075" scrollable="false" hspace="8px" vspace="12px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="36" unit="PIXEL" autoSizing="false" syncminlength="true"/>
        <cl:columns length="1" unit="FRACTION"/>
        <cl:columns length="300" unit="PIXEL" autoSizing="true" syncminlength="false"/>
      </cl:formlayout>
    </cl:group>
    <cl:group std:sid="group-csm000024" id="grpBody" class="inner">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:verticaldata std:sid="v-data-csm000025" width="1024px" height="1034px" autosize="height"/>
      <cl:group std:sid="group-csm000126" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-spacing" value="16"/>
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:verticaldata std:sid="v-data-csm000127" width="960px" height="649px" autosize="height"/>
        <cl:group std:sid="group-csm000128" class="search-list-top">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata std:sid="v-data-csm000129" width="400px" height="36px" autosize="height"/>
          <cl:group std:sid="group-1756a39c" id="grp3">
            <cl:formdata std:sid="f-data-36d7ccef" row="0" col="0" rowspan="1" colspan="1"/>
            <cl:output std:sid="output-csm000130" id="opt2" class="sch-info" value="12" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; company information updates&quot;">
              <cl:flowlayoutdata std:sid="f-data-552053ab" width="96px" height="36px" autosize="width"/>
            </cl:output>
            <cl:flowlayout std:sid="f-layout-537e7170" hspacing="12"/>
          </cl:group>
          <cl:group std:sid="group-csm000132" id="grp2">
            <cl:formdata std:sid="f-data-csm000133" row="0" col="1"/>
            <cl:udc std:sid="ud-control-csm000134" id="udccomviewbutton1" type="udc.pse.com.udcComViewButton">
              <cl:flowlayoutdata std:sid="f-data-csm000135" width="76px" height="36px" autosize="both"/>
              <cl:property name="targetCard" value="grpCardSection" type="control"/>
              <cl:property name="targetTable" value="grpGridSection" type="control"/>
            </cl:udc>
            <cl:combobox std:sid="c-box-d195aaaa" id="cmb3" fieldLabel="Rows per page">
              <cl:flowlayoutdata std:sid="f-data-9b5dca83" width="110px" height="36px" autosize="none"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-csm000136" scrollable="false" hspacing="12" vspacing="12" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-csm000137" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="500" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="400" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-csm000138" id="grpGridSection" fieldLabel="Company Management list" datasetid="dsList" autofit="0, 1, 2, 3, 4, 5" resizablecolumns="0, 1, 2, 3, 4, 5" columnMovable="true">
          <cl:verticaldata std:sid="v-data-csm000139" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-a0233784" width="120px"/>
          <cl:gridcolumn std:sid="g-column-03b07f9a" width="220px"/>
          <cl:gridcolumn std:sid="g-column-86d3f7d9" width="180px"/>
          <cl:gridcolumn std:sid="g-column-c4b88787" width="180px"/>
          <cl:gridcolumn std:sid="g-column-b25cae74" width="160px"/>
          <cl:gridcolumn std:sid="g-column-02001b19" width="160px"/>
          <cl:gridheader std:sid="gh-band-csm000145">
            <cl:gridrow std:sid="g-row-csm000146" height="32px"/>
            <cl:gridcell std:sid="gh-cell-da3c3591" rowindex="0" colindex="0" targetcolumnname="version" sortable="true" filterable="false" text="Version"/>
            <cl:gridcell std:sid="gh-cell-5764a5b4" rowindex="0" colindex="1" targetcolumnname="submissionDate" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-af9f8aa1" rowindex="0" colindex="2" targetcolumnname="submittedBy" sortable="true" filterable="false" text="Submitted By"/>
            <cl:gridcell std:sid="gh-cell-76c75c07" rowindex="0" colindex="3" targetcolumnname="endorsedTo" sortable="true" filterable="false" text="Endorsed To"/>
            <cl:gridcell std:sid="gh-cell-22b0919a" rowindex="0" colindex="4" targetcolumnname="approverStatus" sortable="true" filterable="false" text="Approver Status"/>
            <cl:gridcell std:sid="gh-cell-395eb6c5" rowindex="0" colindex="5" targetcolumnname="exchangeStatus" sortable="true" filterable="false" text="Exchange Status"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-csm000152">
            <cl:gridrow std:sid="g-row-csm000153" height="50px"/>
            <cl:gridcell std:sid="gd-cell-1f539270" rowindex="0" colindex="0" columnname="version">
              <cl:button std:sid="button-fde2b5f6" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="version"/>
                <cl:celldata std:sid="c-data-f3ba275b"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-9a09a699" rowindex="0" colindex="1" columnname="submissionDate">
              <cl:output std:sid="output-b03528e9" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-23ff579d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-6902e2cb" rowindex="0" colindex="2" columnname="submittedBy">
              <cl:output std:sid="output-2c5eae07">
                <cl:celldata std:sid="c-data-71188289"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-6f9683b4" rowindex="0" colindex="3" columnname="endorsedTo">
              <cl:output std:sid="output-52dcb69f">
                <cl:celldata std:sid="c-data-ab79e6cc"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-29f12a75" rowindex="0" colindex="4" columnname="approverStatus">
              <cl:output std:sid="output-23b599a2" value="Output" displayexp="sstr(text, switch(approverStatus){&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;})">
                <cl:celldata std:sid="c-data-4e356a17"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-d332af7c" rowindex="0" colindex="5" columnname="exchangeStatus">
              <cl:output std:sid="output-1eafb684" value="Output" displayexp="text ? sstr(text, switch(exchangeStatus){&#xD;&#xA;&#x9;case &quot;Rejected&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;case &quot;Cancelled&quot; : &quot;badge fill red&quot;&#xD;&#xA;&#x9;default : &quot;badge fill blue&quot;&#xD;&#xA;}) : &quot;-&quot;">
                <cl:celldata std:sid="c-data-76e54383"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:group std:sid="group-1b791d41" id="grpCardSection" class="card-section" visible="false">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="mobile-h-spacing" value="12"/>
          <cl:attribute name="mobile-v-spacing" value="12"/>
          <cl:verticaldata std:sid="v-data-c174a6fd" width="976px" height="313px" autosize="height"/>
          <cl:udc std:sid="ud-control-6b0fa264" id="udccomcompanymanagementcard1" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-6d6af94f" row="0" col="0"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-547da45b" id="udccomcompanymanagementcard2" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-8a1b8080" row="0" col="1"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-510f7f86" id="udccomcompanymanagementcard3" type="udc.pse.card.udcComCompanyManagementCard">
            <cl:formdata std:sid="f-data-b539faa9" row="0" col="2"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-9ec8d59e" scrollable="false" hspace="16px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:udc std:sid="ud-control-csm000169" id="udccompagination1" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-csm000170" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-csm000171" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-csm000172" scrollable="false" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-csm000173" scrollable="true" spacing="0"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>