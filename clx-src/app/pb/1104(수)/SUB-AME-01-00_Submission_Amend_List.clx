            <cl:button std:sid="button-00001038" class="btn-secondary" value="Clear">
              <cl:flowlayoutdata std:sid="f-data-00001039" width="69px" height="36px" autosize="width"/>
            </cl:button>
            <cl:button std:sid="button-0000103a" class="btn-search" value="Search" icon="0">
              <cl:flowlayoutdata std:sid="f-data-0000103b" width="104px" height="36px" autosize="width"/>
            </cl:button>
            <cl:flowlayout std:sid="f-layout-0000103c" scrollable="false" hspacing="8" vspacing="8" halign="right" valign="middle"/>
          </cl:group>
          <cl:verticallayout std:sid="v-layout-0000103d" scrollable="false" spacing="16" leftmargin="24" rightmargin="24" topmargin="20" bottommargin="20"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-0000103e" scrollable="false" spacing="0"/>
      </cl:group>
      <cl:group std:sid="group-00001079" id="grpContent" class="content-wrap">
        <cl:attribute name="mobile-spacing" value="16"/>
        <cl:attribute name="mobile-fit" value="true"/>
        <cl:verticaldata std:sid="v-data-0000107a" width="976px" height="836px" autosize="height"/>
        <cl:group std:sid="group-0000103f" class="search-list-top">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:verticaldata std:sid="v-data-00001040" width="400px" height="36px" autosize="height"/>
          <cl:output std:sid="output-00001041" class="sch-info" value="12" datatype="number" format="#,##0" displayexp="sstr(text, [&quot;point&quot;]) + &quot; submissions&quot;">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:formdata std:sid="f-data-00001042" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-00001043">
            <cl:formdata std:sid="f-data-00001044" row="0" col="1"/>
            <cl:udc std:sid="ud-control-00001045" id="udccomviewbutton1" type="udc.pse.com.udcComViewButton">
              <cl:flowlayoutdata std:sid="f-data-00001046" width="76px" height="36px" autosize="both"/>
              <cl:property name="targetCard" value="grpCardSection" type="control"/>
              <cl:property name="targetTable" value="grpGridSection" type="control"/>
            </cl:udc>
            <cl:combobox std:sid="c-box-00001047" fieldLabel="Rows per page">
              <cl:flowlayoutdata std:sid="f-data-00001048" width="110px" height="36px" autosize="none"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-00001049" scrollable="false" hspacing="12" vspacing="12" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-0000104a" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="500" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="400" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-00001050" id="grpGridSection" fieldLabel="Amend list" datasetid="dsList" autofit="1" resizablecolumns="1, 2, 3, 4" columnMovable="true">
          <cl:verticaldata std:sid="v-data-00001051" width="400px" height="200px" autosize="height"/>
          <cl:rowstyle>
            <cl:expbind property="background-color" category="STYLER" expression="isRead == &quot;N&quot; ? &quot;#EFF6FF&quot; : &quot;&quot;"/>
          </cl:rowstyle>
          <cl:gridcolumn std:sid="g-column-0000104b" width="52px"/>
          <cl:gridcolumn std:sid="g-column-0000104c" width="400px"/>
          <cl:gridcolumn std:sid="g-column-0000104d" width="100px"/>
          <cl:gridcolumn std:sid="g-column-0000104e" width="140px"/>
          <cl:gridcolumn std:sid="g-column-0000104f" width="220px"/>
          <cl:gridheader std:sid="gh-band-00001052">
            <cl:gridrow std:sid="g-row-00001053" height="32px"/>
            <cl:gridcell std:sid="gh-cell-00001054" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No"/>
            <cl:gridcell std:sid="gh-cell-00001055" rowindex="0" colindex="1" targetcolumnname="templateName" sortable="true" filterable="false" text="Template Name"/>
            <cl:gridcell std:sid="gh-cell-00001056" rowindex="0" colindex="2" targetcolumnname="formNo" sortable="true" filterable="false" text="PSE Form No."/>
            <cl:gridcell std:sid="gh-cell-00001057" rowindex="0" colindex="3" targetcolumnname="reportNo" sortable="true" filterable="false" text="Report No."/>
            <cl:gridcell std:sid="gh-cell-00001058" rowindex="0" colindex="4" targetcolumnname="announcementDate" sortable="true" filterable="false" text="Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-00001059">
            <cl:gridrow std:sid="g-row-0000105a" height="50px"/>
            <cl:gridcell std:sid="gd-cell-0000105b" rowindex="0" colindex="0" columnname="no">
              <cl:output std:sid="output-0000105c">
                <cl:expbind property="class" category="CLASS" expression="isRead == &quot;N&quot; ? &quot;font-body-strong&quot; : &quot;&quot;"/>
                <cl:celldata std:sid="c-data-0000105d"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-0000105e" rowindex="0" colindex="1" columnname="templateName">
              <cl:button std:sid="button-0000105f" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="templateName"/>
                <cl:celldata std:sid="c-data-00001060"/>
              </cl:button>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00001061" rowindex="0" colindex="2" columnname="formNo">
              <cl:output std:sid="output-00001062">
                <cl:celldata std:sid="c-data-00001063"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00001064" rowindex="0" colindex="3" columnname="reportNo">
              <cl:output std:sid="output-00001065">
                <cl:celldata std:sid="c-data-00001066"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00001067" rowindex="0" colindex="4" columnname="announcementDate">
              <cl:output std:sid="output-00001068" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-00001069"/>
              </cl:output>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
