  <body std:sid="body-0000107e">
    <cl:group std:sid="group-0000100d" id="grpHeader" class="page-title-wrap">
      <cl:attribute name="mobile-column-count" value="1"/>
      <cl:attribute name="needs-auto-height" value="true"/>
      <cl:verticaldata std:sid="v-data-0000100e" width="1024px" height="48px" autosize="height" sticky="true" stickytopoffset="0"/>
      <cl:udc std:sid="ud-control-0000100f" id="udccomappheader1" type="udc.pse.com.udcComAppHeader">
        <cl:attribute name="needs-auto-height" value="true"/>
        <cl:formdata std:sid="f-data-00001010" row="0" col="0"/>
        <cl:property name="title" value="Amend" type="string"/>
      </cl:udc>
      <cl:formlayout std:sid="f-layout-00001011" scrollable="false" hspace="8px" vspace="12px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
        <cl:rows length="36" unit="PIXEL" autoSizing="false" syncminlength="true"/>
        <cl:columns length="1" unit="FRACTION"/>
      </cl:formlayout>
    </cl:group>
    <cl:group std:sid="group-0000107f" id="grpBody" class="inner">
      <cl:attribute name="mobile-fit" value="true"/>
      <cl:attribute name="mobile-spacing" value="16"/>
      <cl:attribute name="mobile-bottom-margin" value="16"/>
      <cl:attribute name="mobile-left-margin" value="16"/>
      <cl:attribute name="mobile-right-margin" value="16"/>
      <cl:attribute name="mobile-top-margin" value="16"/>
      <cl:verticaldata std:sid="v-data-00001080" width="1024px" height="1263px" autosize="height"/>
      <cl:output std:sid="output-00001081" class="font-caption" value="Amend prior submissions and/or review amended submissions.">
        <cl:verticaldata std:sid="v-data-00001082" width="100px" height="20px" autosize="height"/>
      </cl:output>
      <cl:group std:sid="group-00001012" id="grpSearch" class="search-top-box">
        <cl:verticaldata std:sid="v-data-00001013" width="976px" height="319px" autosize="height"/>
        <cl:group std:sid="group-00001014" id="grpSearchHeader" class="search-head">
          <cl:verticaldata std:sid="v-data-00001015" width="958px" height="102px" autosize="height"/>
          <cl:udc std:sid="ud-control-00001016" id="udccomsearchtoggle1" type="udc.pse.com.udcComSearchToggle">
            <cl:verticaldata std:sid="v-data-00001017" width="942px" height="52px" autosize="height"/>
            <cl:property name="optMsg" value="optMessage" type="control"/>
            <cl:property name="grpId" value="grpSearchFilter" type="control"/>
            <cl:property name="targetOutput" value="optMessage" type="control"/>
            <cl:property name="targetGroup" value="grpSearchFilter" type="control"/>
          </cl:udc>
          <cl:output std:sid="output-00001018" id="optMessage" class="truncate" visible="false" value="No filters applied">
            <cl:verticaldata std:sid="v-data-00001019" width="100px" height="50px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-0000101a" scrollable="false" spacing="0"/>
        </cl:group>
        <cl:group std:sid="group-0000101b" id="grpSearchFilter" class="sch-filter-box">
          <cl:attribute name="mobile-fit" value="true"/>
          <cl:attribute name="mobile-bottom-margin" value="16"/>
          <cl:attribute name="mobile-left-margin" value="16"/>
          <cl:attribute name="mobile-right-margin" value="16"/>
          <cl:attribute name="mobile-top-margin" value="16"/>
          <cl:attribute name="mobile-spacing" value="14"/>
          <cl:verticaldata std:sid="v-data-0000101c" width="974px" height="215px" autosize="height"/>
          <cl:group std:sid="group-0000101d" class="filter-form">
            <cl:verticaldata std:sid="v-data-0000101e" width="926px" height="102px" autosize="height"/>
            <cl:group std:sid="group-0000101f" class="row">
              <cl:attribute name="mobile-column-count" value="1"/>
              <cl:verticaldata std:sid="v-data-00001020" width="926px" height="102px" autosize="height"/>
              <cl:group std:sid="group-00001021">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-00001022" width="100" height="67" row="0" col="0"/>
                <cl:output std:sid="output-00001023" class="font-label" value="Template Name">
                  <cl:verticaldata std:sid="v-data-00001024" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:group std:sid="group-00001025" class="input-group">
                  <cl:attribute name="mobile-column-count" value="1"/>
                  <cl:verticaldata std:sid="v-data-00001026" width="539px" height="36px" autosize="height"/>
                  <cl:combobox std:sid="c-box-00001027" fieldLabel="Select Template Name" multiple="true">
                    <cl:formdata std:sid="f-data-00001028" row="0" col="0"/>
                  </cl:combobox>
                  <cl:inputbox std:sid="i-box-00001029" fieldLabel="Template Name" placeholder="Enter a template name">
                    <cl:formdata std:sid="f-data-0000102a" row="0" col="1"/>
                  </cl:inputbox>
                  <cl:formlayout std:sid="f-layout-0000102b" scrollable="false" hspace="8px" vspace="8px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                    <cl:rows length="36" unit="PIXEL"/>
                    <cl:columns length="200" unit="PIXEL"/>
                    <cl:columns length="1" unit="FRACTION"/>
                  </cl:formlayout>
                </cl:group>
                <cl:group std:sid="group-fb759e0f" id="grpSelectChips">
                  <cl:verticaldata std:sid="v-data-7aac319f" width="457px" height="36px" autosize="height"/>
                  <cl:udc std:sid="ud-control-8350a73f" type="udc.pse.com.udcComSearchCompanyNameChip">
                    <cl:flowlayoutdata std:sid="f-data-849acfb5" width="161px" height="24px" autosize="width"/>
                  </cl:udc>
                  <cl:udc std:sid="ud-control-ce1fd3d9" type="udc.pse.com.udcComSearchCompanyNameChip">
                    <cl:flowlayoutdata std:sid="f-data-067f0cfc" width="161px" height="24px" autosize="width"/>
                  </cl:udc>
                  <cl:flowlayout std:sid="f-layout-93550840" hspacing="8"/>
                </cl:group>
                <cl:verticallayout std:sid="v-layout-0000102c" spacing="6"/>
              </cl:group>
              <cl:group std:sid="group-0000102d">
                <cl:attribute name="needs-auto-height" value="true"/>
                <cl:formdata std:sid="f-data-0000102e" row="0" col="1"/>
                <cl:output std:sid="output-0000102f" class="font-label" value="Period">
                  <cl:verticaldata std:sid="v-data-00001030" width="100px" height="18px" autosize="height"/>
                </cl:output>
                <cl:udc std:sid="ud-control-00001031" id="udccomdateperiodpicker1" type="udc.pse.com.udcComDatePeriodPicker">
                  <cl:verticaldata std:sid="v-data-00001032" width="300px" height="36px" autosize="height"/>
                </cl:udc>
                <cl:verticallayout std:sid="v-layout-00001033" spacing="6"/>
              </cl:group>
              <cl:formlayout std:sid="f-layout-00001034" scrollable="false" hspace="12px" vspace="14px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
                <cl:rows length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION"/>
                <cl:columns length="1" unit="FRACTION" minlength="0"/>
              </cl:formlayout>
            </cl:group>
            <cl:verticallayout std:sid="v-layout-00001035" scrollable="false" spacing="14"/>
          </cl:group>
          <cl:group std:sid="group-00001036" class="search-btn-wrap">
