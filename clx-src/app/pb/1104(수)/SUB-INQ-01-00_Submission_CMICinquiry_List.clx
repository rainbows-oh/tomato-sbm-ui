            <cl:gridcell std:sid="gh-cell-0000203c" rowindex="0" colindex="4" targetcolumnname="inquiryDate" sortable="true" filterable="false" text="Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-0000204f">
            <cl:gridrow std:sid="g-row-00002050" height="50px"/>
            <cl:gridcell std:sid="gd-cell-0000203f" rowindex="0" colindex="0" columnname="no">
              <cl:output std:sid="output-0000203d">
                <cl:expbind property="class" category="CLASS" expression="isRead == &quot;N&quot; ? &quot;fw-bold&quot; : &quot;&quot;"/>
                <cl:celldata std:sid="c-data-0000203e"/>
              </cl:output>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00002041" rowindex="0" colindex="1" columnname="isRead">
              <cl:checkbox std:sid="c-box-e8649a67" id="cbx1" class="chk-mail" fieldLabel="Unread" value="" truevalue="Y" falsevalue="N">
                <std:metadata>
                  <std:property key="template-uuid" value="70ecc1f1-5379-44fd-bd4c-c8721756d3db"/>
                  <std:property key="template-rev" value="1"/>
