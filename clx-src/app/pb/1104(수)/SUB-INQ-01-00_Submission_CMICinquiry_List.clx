                <cl:celldata std:sid="c-data-e67368e8" halign="CENTER" valign="CENTER" width="28" height="28"/>
              </cl:checkbox>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-00002044" rowindex="0" colindex="2" columnname="templateName">
              <cl:button std:sid="button-00002042" class="btn-link">
                <cl:expbind property="value" category="PROPERTY" expression="templateName"/>
                <cl:celldata std:sid="c-data-00002043"/>
