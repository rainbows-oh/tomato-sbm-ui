            </cl:udc>
            <cl:combobox std:sid="c-box-d195aaaa" id="cmb3" fieldLabel="Rows per page" value="15">
              <cl:flowlayoutdata std:sid="f-data-9b5dca83" width="110px" height="36px" autosize="none"/>
              <cl:item std:sid="t-item-ed1cc792" label="15/page" value="15"/>
            </cl:combobox>
            <cl:flowlayout std:sid="f-layout-csm000136" scrollable="false" hspacing="12" vspacing="12" halign="right" valign="middle"/>
          </cl:group>
          <cl:formlayout std:sid="f-layout-csm000137" scrollable="false" hspace="1fr" vspace="10px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="500" unit="PIXEL" autoSizing="true" syncminlength="false"/>
            <cl:columns length="400" unit="PIXEL" autoSizing="true" shadetype="NONE" shadecolor="transparent" syncminlength="false"/>
          </cl:formlayout>
        </cl:group>
        <cl:grid std:sid="grid-csm000138" id="grpGridSection" datasetid="dsList" autofit="2" resizablecolumns="all" columnMovable="true">
          <cl:verticaldata std:sid="v-data-csm000139" width="400px" height="200px" autosize="height"/>
          <cl:gridcolumn std:sid="g-column-f0910d5b" width="56px"/>
          <cl:gridcolumn std:sid="g-column-4c505f58" width="56px"/>
          <cl:gridcolumn std:sid="g-column-982d62a6" width="520px"/>
          <cl:gridcolumn std:sid="g-column-7ef17754" width="160px"/>
          <cl:gridcolumn std:sid="g-column-be8137c0" width="120px"/>
          <cl:gridcolumn std:sid="g-column-ca2b7716" width="220px"/>
          <cl:gridcolumn std:sid="g-column-70fabad2" width="220px"/>
          <cl:gridheader std:sid="gh-band-csm000145">
            <cl:gridrow std:sid="g-row-csm000146" height="32px"/>
            <cl:gridcell std:sid="gh-cell-17e9cafa" rowindex="0" colindex="0" targetcolumnname="no" sortable="false" filterable="false" text="No"/>
            <cl:gridcell std:sid="gh-cell-2efa1d1e" rowindex="0" colindex="1" sortable="false" filterable="false" text=""/>
            <cl:gridcell std:sid="gh-cell-9d9f171b" rowindex="0" colindex="2" targetcolumnname="subject" sortable="true" filterable="false" text="Subject"/>
            <cl:gridcell std:sid="gh-cell-47d341a8" rowindex="0" colindex="3" targetcolumnname="submittedBy" sortable="true" filterable="false" text="Submitted By"/>
            <cl:gridcell std:sid="gh-cell-7e04be6d" rowindex="0" colindex="4" targetcolumnname="status" sortable="true" filterable="false" text="Status"/>
            <cl:gridcell std:sid="gh-cell-eb218408" rowindex="0" colindex="5" targetcolumnname="submissionDate" sortable="true" filterable="false" text="Submission Date and Time"/>
            <cl:gridcell std:sid="gh-cell-255398ac" rowindex="0" colindex="6" targetcolumnname="responseDate" sortable="true" filterable="false" text="Response Date and Time"/>
          </cl:gridheader>
          <cl:griddetail std:sid="gd-band-csm000152">
            <cl:gridrow std:sid="g-row-csm000153" height="50px"/>
            <cl:gridcell std:sid="gd-cell-be2750b6" rowindex="0" colindex="0" columnname="no">
              <cl:output std:sid="output-ff5c6d42">
                <cl:celldata std:sid="c-data-fd28d16b"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-657cdb10" rowindex="0" colindex="1" columnname="unread">
              <cl:checkbox std:sid="c-box-e8649a67" id="cbx1" class="chk-mail" truevalue="0" falsevalue="1" text="Check">
                <cl:celldata std:sid="c-data-7d65322f" halign="CENTER" valign="CENTER" width="28" height="28"/>
              </cl:checkbox>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-ce2de8b7" rowindex="0" colindex="2" columnname="subject">
              <cl:button std:sid="button-8dc5dba9" class="btn-link" displayexp="replies == &quot;&quot; ? subject : subject + sstr(replies, switch(replyStatus){&#xD;&#xA;&#x9;case &quot;answered&quot; : &quot;badge count answered&quot;&#xD;&#xA;&#x9;case &quot;closed&quot; : &quot;badge count close&quot;&#xD;&#xA;})">
                <cl:expbind property="value" category="PROPERTY" expression="subject"/>
                <cl:celldata std:sid="c-data-9e036dbe"/>
              </cl:button>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-219ae7f3" rowindex="0" colindex="3" columnname="submittedBy">
              <cl:output std:sid="output-e58b801b">
                <cl:celldata std:sid="c-data-90543878"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-e4980e7b" rowindex="0" colindex="4" columnname="status">
              <cl:output std:sid="output-9fbfe47d" value="Output" displayexp="sstr(text, &quot;badge fill blue&quot;)">
                <cl:celldata std:sid="c-data-5a0afb9d"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-11250b53" rowindex="0" colindex="5" columnname="submissionDate">
              <cl:output std:sid="output-077dd5c7" datatype="date" format="MM-DD-YYYY hh:mm:ss A">
                <cl:celldata std:sid="c-data-6eac094d"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
            <cl:gridcell std:sid="gd-cell-cbec2eca" rowindex="0" colindex="6" columnname="responseDate">
              <cl:output std:sid="output-835dd496" datatype="date" format="MM-DD-YYYY hh:mm:ss A" displayexp="text ? text : &quot;-&quot;">
                <cl:celldata std:sid="c-data-61352fc9"/>
              </cl:output>
              <cl:expbind property="class" category="CLASS" expression="unread == 1 ? &quot;highlight&quot; : &quot;&quot;"/>
            </cl:gridcell>
          </cl:griddetail>
        </cl:grid>
        <cl:group std:sid="group-1b791d41" id="grpCardSection" class="card-section" visible="false">
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="mobile-v-spacing" value="12"/>
          <cl:attribute name="mobile-h-spacing" value="12"/>
          <cl:verticaldata std:sid="v-data-c174a6fd" width="976px" height="313px" autosize="height"/>
          <cl:udc std:sid="ud-control-9df5b644" type="udc.pse.com.udcComQnACard">
            <cl:formdata std:sid="f-data-03c2236e" row="0" col="0"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-a41b21d4" type="udc.pse.com.udcComQnACard">
            <cl:formdata std:sid="f-data-9fbce77f" row="0" col="1"/>
          </cl:udc>
          <cl:udc std:sid="ud-control-80ed3d1c" type="udc.pse.com.udcComQnACard">
            <cl:formdata std:sid="f-data-4e032112" row="0" col="2"/>
          </cl:udc>
          <cl:formlayout std:sid="f-layout-9ec8d59e" scrollable="false" hspace="16px" vspace="16px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
            <cl:rows length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:udc std:sid="ud-control-csm000169" id="udccompagination1" type="udc.pse.com.udcComPagination">
          <cl:verticaldata std:sid="v-data-csm000170" width="1024px" height="40px" autosize="height"/>
        </cl:udc>
        <cl:verticallayout std:sid="v-layout-csm000171" scrollable="false" spacing="20"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-csm000172" scrollable="false" spacing="20" leftmargin="24" rightmargin="24" topmargin="24" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-csm000173" scrollable="true" spacing="0"/>
