<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-c32a34a9" version="1.0.6164">
  <head std:sid="head-5abc4bc1">
    <screen std:sid="screen-fb8a98d7" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-59e32d1a" id="EXB-DIV" name="EXB-DIV" width="768px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-5e050703" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="360"/>
    <cl:model std:sid="model-6f91bde2"/>
    <cl:appspec title="Company Logo"/>
  </head>
  <body std:sid="body-cf2ffd9d" class="logo-upload-pop">
    <cl:group std:sid="group-07f543f8" id="grp7">
      <cl:verticaldata std:sid="v-data-276670c6" width="800px" height="363px" autosize="height"/>
      <cl:output std:sid="output-d18dc604" id="opt1" class="sub-txt" value="Preview and update the company logo.">
        <cl:verticaldata std:sid="v-data-d6ffe7de" width="100px" height="20px" autosize="height"/>
      </cl:output>
      <cl:group std:sid="group-a2fa4558" id="grp1">
        <cl:verticaldata std:sid="v-data-06c951b8" width="400px" height="128px" autosize="height"/>
        <cl:img std:sid="image-3f67b1c8" id="img1" fieldLabel="logo image" alt="logo image">
          <cl:formdata std:sid="f-data-d515528b" row="0" col="0"/>
        </cl:img>
        <cl:group std:sid="group-c01e3bf7" id="grp3">
          <cl:formdata std:sid="f-data-e23daa60" row="0" col="1"/>
          <cl:output std:sid="output-91c9ce58" id="opt3" class="label" value="Selected file">
            <cl:formdata std:sid="f-data-d6e1bc65" row="0" col="0"/>
          </cl:output>
          <cl:output std:sid="output-c72fd8ec" id="opt4" value="pse-company-logo.svg">
            <cl:formdata std:sid="f-data-9f51aa26" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-1f845cdc" id="opt5" class="sub-txt" value="42 KB">
            <cl:formdata std:sid="f-data-ef06b207" row="2" col="0"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-b94df001" scrollable="false" hspace="0px" vspace="4px" top-margin="1fr" right-margin="0px" bottom-margin="1fr" left-margin="0px">
            <cl:rows length="20" autoSizing="true" syncminlength="false"/>
            <cl:rows length="20" autoSizing="true" syncminlength="false"/>
            <cl:rows length="20" autoSizing="true" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:formlayout std:sid="f-layout-be4adad8" scrollable="false" hspace="12px" vspace="12px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
          <cl:rows length="128" unit="PIXEL"/>
          <cl:columns length="128" unit="PIXEL"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
      </cl:group>
      <cl:group std:sid="group-385f4483" id="grp2" class="btn-wrap">
        <cl:verticaldata std:sid="v-data-358eb813" width="400px" height="36px" autosize="height"/>
        <cl:output std:sid="output-c5c023c9" id="opt2" class="sub-txt" value="Minimum width: 175px, Maximum file size: 2MB">
          <cl:flowlayoutdata std:sid="f-data-4a726417" width="301px" height="36px" autosize="width"/>
        </cl:output>
        <cl:button std:sid="button-86358a59" id="btn1" class="btn-inline" value="Browse">
          <cl:flowlayoutdata std:sid="f-data-cbef0a99" width="100px" height="36px" autosize="width"/>
        </cl:button>
        <cl:flowlayout std:sid="f-layout-268d6d9f" hspacing="8" vspacing="8" halign="right"/>
      </cl:group>
      <cl:group std:sid="group-28296f9d" id="grp4" class="upload-info">
        <cl:verticaldata std:sid="v-data-dc6ded77" width="400px" height="91px" autosize="height"/>
        <cl:group std:sid="group-a41780e8" id="grp5">
          <cl:formdata std:sid="f-data-e7f03e44" row="0" col="0"/>
          <cl:output std:sid="output-c6f4f985" id="opt6" class="label" value="New file">
            <cl:formdata std:sid="f-data-a62b28e6" row="0" col="0"/>
          </cl:output>
          <cl:output std:sid="output-547e5eb2" id="opt7" value="pse-company-logo.svg">
            <cl:formdata std:sid="f-data-246426e6" row="1" col="0"/>
          </cl:output>
          <cl:output std:sid="output-705cdf01" id="opt8" class="sub-txt" value="42 KB">
            <cl:formdata std:sid="f-data-2f61f7e3" row="2" col="0"/>
          </cl:output>
          <cl:formlayout std:sid="f-layout-854a3c03" scrollable="false" hspace="0px" vspace="4px">
            <cl:rows length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
            <cl:rows length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
            <cl:rows length="1" unit="FRACTION" autoSizing="true" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION"/>
          </cl:formlayout>
        </cl:group>
        <cl:group std:sid="group-1ff29fa0" id="grp6" class="btn-wrap">
          <cl:formdata std:sid="f-data-d683eb04" valign="CENTER" height="36" row="0" col="1" rowspan="1" colspan="1"/>
          <cl:button std:sid="button-6514893a" id="btn2" class="btn-close" fieldLabel="delete" value="" icon="0">
            <cl:flowlayoutdata std:sid="f-data-46cbf643" width="32px" height="32px" autosize="none"/>
          </cl:button>
          <cl:button std:sid="button-bb1924b8" id="btn3" class="btn-save" value="Upload">
            <cl:flowlayoutdata std:sid="f-data-d378fdd3" width="100px" height="36px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-aba6ffe8" hspacing="8" vspacing="8" halign="right"/>
        </cl:group>
        <cl:formlayout std:sid="f-layout-a7fd9779" scrollable="false" hspace="8px" vspace="0px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
          <cl:columns length="200" unit="PIXEL" autoSizing="true" syncminlength="false"/>
        </cl:formlayout>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-a0080c3c" spacing="20" leftmargin="24" rightmargin="24" topmargin="4" bottommargin="24"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-6c55029a" spacing="20"/>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>